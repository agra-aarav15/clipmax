{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "SKIP_ENV_VALIDATION"],
  "globalDependencies": [".env", ".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": []
    }
  }
}
