# ─────────────────────────────────────────────────────────────
# ClipMax environment template
#
# Web  → copy to apps/web/.env.local (only NEXT_PUBLIC_* reach the browser)
# Worker → copy to apps/worker/.env
#
# Local development connects directly to hosted Supabase and Cloudflare R2.
# There is no local database or object-store emulator.
#
# Never commit real secrets. Never prefix a secret with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3200

# Supabase (Phase 2) — hosted project, not a local stack
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — private bucket, no public access
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipmax
R2_ENDPOINT=
R2_PRESIGN_PUT_TTL_SECONDS=900
R2_SIGNED_GET_TTL_SECONDS=3600

# Razorpay (Phase 6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=

# AI providers (worker)
# Hosted transcription needs the matching key. Local faster-whisper is the no-key alternative:
#   cd apps/worker && uv sync --extra local-whisper
# then set WHISPER_PROVIDER=local and WHISPER_MODEL=base.en.
WHISPER_PROVIDER=openai
WHISPER_MODEL=whisper-1
OPENAI_API_KEY=
GROQ_API_KEY=
# Without an LLM key the worker uses the labelled heuristic highlight fallback.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Worker runtime (Phase 4)
ENVIRONMENT=development
WORKER_ID=local
WORKER_CONCURRENCY=1
JOB_BUDGET_SECONDS=3000
MAX_SOURCE_DURATION_SECONDS=900
MAX_SOURCE_BYTES=524288000
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
LOG_LEVEL=INFO
TEST_MODE=false

# Ops — authenticates /api/cron/renew-free-credits (32+ random bytes)
CRON_SECRET=
