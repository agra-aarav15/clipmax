# Copy to apps/web/.env.local
# Only NEXT_PUBLIC_* values are exposed to the browser.

NEXT_PUBLIC_APP_URL=http://localhost:3200
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipmax
R2_ENDPOINT=
R2_PRESIGN_PUT_TTL_SECONDS=900
R2_SIGNED_GET_TTL_SECONDS=3600

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=

# Authenticates /api/cron/renew-free-credits (Vercel Cron sends it automatically)
CRON_SECRET=
